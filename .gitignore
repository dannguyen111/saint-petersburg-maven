# Ignore all CSV files
*.csv
**/*.csv
*.xlsx
*.xls
**/*.xlsx
**/*.xls

# But keep cards.csv tracked
!cards.csv

# Ignore all log files
*.log
**/*.log

# Ignore model files
*.model
**/*.model

# Ignore other Team's files
saint-petersburg/src/main/java/JFMTFeatures.java
saint-petersburg/src/main/java/JFMTPlayer.java
saint-petersburg/src/main/java/MaiNeLR2.java
saint-petersburg/src/main/java/MaiNePlayer.java
saint-petersburg/src/main/java/MiMaPlayer.java
saint-petersburg/src/main/java/MiMaStateFeatures.java
saint-petersburg/src/main/java/OKHybridPlayer.java

# ...and their compiled output
saint-petersburg/target/classes/JFMTFeatures.class
saint-petersburg/target/classes/JFMTFeatures$*.class
saint-petersburg/target/classes/JFMTPlayer.class
saint-petersburg/target/classes/MaiNeLR2.class
saint-petersburg/target/classes/MaiNeLR2$*.class
